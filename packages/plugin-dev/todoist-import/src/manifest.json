{
  "id": "todoist-import",
  "manifestVersion": 1,
  "name": "Todoist 导入",
  "version": "1.0.0",
  "minSupVersion": "18.0.0",
  "description": "导入 Todoist 项目、任务、子任务、标签和到期日期；仅添加内容，不更改已有数据。",
  "author": "SuperProductivity",
  "homepage": "https://github.com/super-productivity/super-productivity",
  "hooks": [],
  "permissions": [
    "http",
    "getTasks",
    "getAllProjects",
    "addProject",
    "getAllTags",
    "addTag",
    "batchUpdateForProject",
    "updateTask",
    "showSnack"
  ],
  "allowedHosts": ["api.todoist.com"],
  "iFrame": true,
  "isSkipMenuEntry": true,
  "i18n": {
    "languages": ["en", "zh"]
  },
  "icon": "icon.svg"
}
